#!/usr/bin/make -f
include /usr/share/dpkg/pkg-info.mk
%:
	dh $@ --with dkms

override_dh_auto_build override_dh_auto_test override_dh_auto_clean:

override_dh_auto_install:
	install -Dm644 -t debian/coral-usb-hwmon-dkms/usr/src/coral-usb-hwmon-$(DEB_VERSION_UPSTREAM) Makefile coral_usb_hwmon.c

override_dh_dkms:
	dh_dkms -V $(DEB_VERSION_UPSTREAM)
